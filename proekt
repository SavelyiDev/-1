# --- РАБОТА С БАЗОЙ ДАННЫХ (SQLite) ---
def init_db():
    conn = sqlite3.connect("ecotrack.db")
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS test_results (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            chat_id INTEGER,
            score INTEGER,
            date TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    conn.commit()
    conn.close()

def save_result(chat_id, score):
    conn = sqlite3.connect("ecotrack.db")
    cursor = conn.cursor()
    cursor.execute("INSERT INTO test_results (chat_id, score) VALUES (?, ?)", (chat_id, score))
    conn.commit()
    conn.close()

def get_user_history(chat_id):
    conn = sqlite3.connect("ecotrack.db")
    cursor = conn.cursor()
    cursor.execute("SELECT score, date FROM test_results WHERE chat_id = ? ORDER BY date DESC LIMIT 5", (chat_id,))
    rows = cursor.fetchall()
    conn.close()
    return rows

init_db()

