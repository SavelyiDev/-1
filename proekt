@bot.message_handler(func=lambda message: message.text == "📈 Моя динамика")
def show_history(message):
    history = get_user_history(message.chat.id)
    if not history:
        bot.send_message(message.chat.id, "❌ Ты еще ни разу не проходил эко-тест. Нажми на кнопку **«📊 Пройти эко-тест»**!")
        return

    text = "📈 **История твоих последних тестов и графики:**\n\n"
    for i, (score, date) in enumerate(reversed(history), 1):
        clean_date = date.split()[0] # Берем только дату ГГГГ-ММ-ДД

        # Строим визуальный график-бар из кубиков (1 кубик = 50 кг CO2)
        cubes_count = max(1, round(score / 50))
        if score <= 120:
            chart = "🟩" * cubes_count
        elif score <= 280:
            chart = "🟨" * cubes_count
        else:
            chart = "🟥" * cubes_count

        text += f"{i}. {clean_date} — **{score} кг**\n`{chart}`\n\n"

    text += "*Цель: сделать полоску из зеленых кубиков как можно короче!*"
    bot.send_message(message.chat.id, text, parse_mode="Markdown")

