@bot.callback_query_handler(func=lambda call: True)
def handle_query(call):
    chat_id = call.message.chat.id

    if chat_id not in user_states:
        bot.answer_callback_query(call.id, "Сессия устарела. Запусти тест заново через меню.", show_alert=True)
        bot.edit_message_reply_markup(chat_id, call.message.message_id, reply_markup=None)
        return

    data = call.data

    # Шаг 1: Транспорт
    if data.startswith("trans_"):
        if data == "trans_car":
            user_states[chat_id]["score"] += 220
            user_states[chat_id]["rec"] += "• Твой автомобиль сильно влияет на климат. Старайся чаще ходить пешком на короткие дистанции. 🚗\n"
        elif data == "trans_public":
            user_states[chat_id]["score"] += 60
            user_states[chat_id]["rec"] += "• Автобус и метро — хороший выбор. За счет массовости поездок удельный след минимален. 🚌\n"
        elif data == "trans_foot":
            user_states[chat_id]["score"] += 0
            user_states[chat_id]["rec"] += "• Идеальный выбор транспорта! Пешие прогулки не оставляют углеродного следа. 🚶‍♂️\n"

        bot.edit_message_text(
            chat_id=chat_id, message_id=call.message.message_id,
            text="🟢 **Шаг 2 из 4:** Как выглядит твой рацион питания?", reply_markup=diet_inline()
        )
        bot.answer_callback_query(call.id)
        return  # ОСТАНАВЛИВАЕМ ФУНКЦИЮ, ЖДЕМ СЛЕДУЮЩЕГО НАЖАТИЯ

    # Шаг 2: Диета
    elif data.startswith("diet_"):
        if data == "diet_meat":
            user_states[chat_id]["score"] += 140
            user_states[chat_id]["rec"] += "• Мясная промышленность оставляет огромный след. Попробуй устраивать один день в неделю без мяса. 🥩\n"
        elif data == "diet_veg":
            user_states[chat_id]["score"] += 30
            user_states[chat_id]["rec"] += "• Растительная диета экономит воду и ресурсы планеты. Отличный выбор! 🥦\n"

        bot.edit_message_text(
            chat_id=chat_id, message_id=call.message.message_id,
            text="🟢 **Шаг 3 из 4:** Сортируешь ли ты бытовые отходы и мусор?", reply_markup=waste_inline()
        )
        bot.answer_callback_query(call.id)
        return  # ОСТАНАВЛИВАЕМ ФУНКЦИЮ, ЖДЕМ СЛЕДУЮЩЕГО НАЖАТИЯ

    # Шаг 3: Мусор
    elif data.startswith("waste_"):
        if data == "waste_none":
            user_states[chat_id]["score"] += 90
            user_states[chat_id]["rec"] += "• Смешанный мусор отправляется на полигоны. Начни хотя бы со сдачи батареек и пластика. 🗑️\n"
        elif data == "waste_part":
            user_states[chat_id]["score"] += 45
            user_states[chat_id]["rec"] += "• Хорошее начало! Разделение пластика заметно снижает нагрузку на экосистемы. ♻️\n"
        elif data == "waste_full":
            user_states[chat_id]["score"] += 10
            user_states[chat_id]["rec"] += "• Потрясающе! Полная сортировка отходов минимизирует замусоривание планеты. 🌍\n"

        bot.edit_message_text(
            chat_id=chat_id, message_id=call.message.message_id,
            text="🟢 **Шаг 4 из 4:** Как дома расходуется электроэнергия?", reply_markup=energy_inline()
        )
        bot.answer_callback_query(call.id)
        return  # ОСТАНАВЛИВАЕМ ФУНКЦИЮ, ЖДЕМ СЛЕДУЮЩЕГО НАЖАТИЯ

    # Шаг 4: Электроэнергия и ФИНАЛ
    elif data.startswith("energy_"):
        if data == "energy_high":
            user_states[chat_id]["score"] += 80
            user_states[chat_id]["rec"] += "• Потребление энергии в быту вносит большой вклад в выбросы ТЭЦ. Попробуй заменить лампы на светодиодные (LED). 💡\n"
        elif data == "energy_low":
            user_states[chat_id]["score"] += 20
            user_states[chat_id]["rec"] += "• Отличная бытовая осознанность! Энергосберегающие лампы и выключение приборов берегут ресурсы. 🔌\n"

        # Этот код сработает только на 4 шаге, когда переменные гарантированно заполнены
        final_score = user_states[chat_id]["score"]
        recommendations = user_states[chat_id]["rec"]

        if final_score <= 120:
            status = "👑 **Эко-Герой** (Минимальный след!)"
        elif final_score <= 280:
            status = "🌱 **Осознанный Житель** (Хороший баланс)"
        else:
            status = "🏭 **Углеродный Гигант** (Высокая нагрузка на климат)"

        save_result(chat_id, final_score)

        result_text = (
            "📊 **Твой экологический профиль готов!**\n\n"
            f"Твой след: около **{final_score} кг CO₂** в месяц.\n"
            f"Твой текущий статус: {status}\n\n"
            "💡 **Персональные советы по улучшению:**\n"
            f"{recommendations}"
        )

        bot.edit_message_text(
            chat_id=chat_id, message_id=call.message.message_id,
            text=result_text, reply_markup=None, parse_mode="Markdown"
        )
        bot.answer_callback_query(call.id)

        del user_states[chat_id]
bot.infinity_polling()
